    class GameScene {
        -object playerData
        -socket socket
        -boolean isLAN
        -string roomCode
        -string playerRole
        -boolean vsBot
        -Card selectedCard
        -object cardHandSize
        -object cardFieldSize
        -TurnManager turn
        -object turnTimer
        -BotAI bot
        +init(data) void
        +preload() void
        +create() void
        +update(time) void
        +startPlayerTurn() void
        +endPlayerTurn(forcedAttackSkip) void
        +startOpponentTurn() void
        +endOpponentTurn(opponentActed) void
        +checkVictoryConditions() void
        +endGame(winner) void
        +handlePlayCard(cardObject, dropZone) void
        +attemptToFuse(selectedCardObject, targetCardObject) void
        +attemptToFuseFromHand(handCardObject, fieldCardObject) void
        +handleAttack(attackingCardObject, defendingCardObject) void
        +handleDirectAttack(attackingCardObject) void
        +animateAttack(attackingCardObject, target, result) void
        +revPlayerCard(cardObject) void
        +revealOpponentCard(cardObject) void
        +destroyCard(owner, fieldIndex, instanceId) void
        +buildBotContext() object
        +executeBotPlan(plan) void
        +useEssencePower(essenceType) void
        +revealOpponentHandForTurn() void
        +createFieldDecor() void
        +createSlotsRow(y, name, numSlots) void
        +createCardsRow(y, name, hand) void
        +createPlayerCard(x, y, cardData) void
        +createOpponentCard(x, y, cardData) void
        +createFieldCard(slotObj, cardData, options) void
        +createDecks() void
        +updateDeckCounts() void
        +onCardClicked(clickedCard) void
        +onSlotClicked(clickedSlot) void
        +onOpponentSlotClicked(clickedSlot) void
        +selectCard(cardObject) void
        +deselectCard(animate) void
        +refreshPlayerHand() void
        +refreshOpponentHand() void
        +handleRemoteGameEvent(payload) void
    }

    GameScene *-- Player : 2 jugadores
    GameScene *-- TurnManager : controla turnos
    GameScene *-- BotAI : vs bot
    GameScene *-- LANClient : vs LAN
    GameScene ..> VictoryEvaluator : consulta
    GameScene ..> LevelAttackRule : delega reglas de ataque
    GameScene ..> EssencePowerService : valida poderes
    GameScene ..> ConvergenceService : valida convergencia
    GameScene --> UIScene : corre en paralelo
    UIScene ..> GameScene : lee estado y escucha eventos