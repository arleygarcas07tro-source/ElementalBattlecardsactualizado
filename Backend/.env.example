# Configuración del backend — Elemental Battlecards
# Copia este archivo a ".env" y ajusta los valores reales.
# Nunca subas ".env" a git (ya está en .gitignore).

# Servidor
PORT=3001
NODE_ENV=development
# Origen permitido para CORS ("*" = cualquiera, no recomendado en producción)
CORS_ORIGIN=*

# Base de datos
# DB_ENABLED=true habilita las rutas de autenticación.
DB_ENABLED=true
# true = SQLite local (Backend/database.sqlite); false = PostgreSQL.
DB_USE_SQLITE=false

# --- PostgreSQL (se usa cuando DB_USE_SQLITE=false) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=elemental
DB_USER=postgres
DB_PASS=cambia_esta_contraseña
# true solo para servicios gestionados que exigen SSL (Neon, Supabase, RDS...)
DB_REQUIRE_SSL=false

# Autenticación (JWT)
# Genera uno largo y aleatorio, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=1h
